# Official MyAnimeList API v2 client ID (https://myanimelist.net/apiconfig).
# Read server-side only; do not rename to NEXT_PUBLIC_*. Leave empty to use the Jikan / public list-feed fallbacks.
MAL_CLIENT_ID=

# Optional: override the Jikan base URL (e.g. a self-hosted instance).
# JIKAN_BASE_URL=https://api.jikan.moe/v4
